# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth
JWT_SECRET="your-long-random-secret-at-least-32-chars"

# The Blue Alliance API (etkinlik listesi, takim listesi)
# https://www.thebluealliance.com/apidocs
TBA_API_KEY=""

# FRC Events API (canli skor, program, siralama)
# https://frc-events.firstinspires.org/services/api/register
FRC_EVENTS_API_USER=""
FRC_EVENTS_API_KEY=""

# Web Push (maç bildirimleri – PWA ana ekrana eklenince)
# Oluşturmak için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Cron ile bildirim gönderimi (Vercel Cron secret)
CRON_SECRET=""

# Callister AI – scout verisi analizi (Google Gemini)
# https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=""
