# ===========================================
# Gerekli (uygulama çalışması için)
# ===========================================

# Veritabanı (Neon, Supabase vb. PostgreSQL)
# prisma/schema.prisma bu değeri kullanır
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT – giriş oturumları için. Production'da uzun ve rastgele bir değer kullan
JWT_SECRET="your-long-random-secret-at-least-32-chars"

# Tek admin hesabı (opsiyonel ama önerilir):
# Bu e-posta ile kayıt olan / giriş yapan kullanıcı otomatik admin olur.
ADMIN_EMAIL=""

# ===========================================
# The Blue Alliance (TBA)
# Etkinlik listesi, takım listesi, maç verisi (fallback)
# https://www.thebluealliance.com/apidocs
# ===========================================
TBA_API_KEY=""

# ===========================================
# FRC Events API (isteğe bağlı)
# Canlı skor, program, sıralama – yoksa TBA fallback kullanılır
# https://frc-events.firstinspires.org/services/api/register
# ===========================================
FRC_EVENTS_API_USER=""
FRC_EVENTS_API_KEY=""

# ===========================================
# Web Push (maç bildirimleri – PWA)
# Oluşturmak: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ===========================================
# Cron – bildirim endpoint’i (cron-job.org)
# URL: GET https://SITE/api/cron/notify-upcoming?secret=BU_DEGER
# ===========================================
CRON_SECRET=""

# ===========================================
# Callister AI – scout verisi analizi (Google Gemini)
# https://aistudio.google.com/apikey
# ===========================================
GOOGLE_GEMINI_API_KEY=""

# ===========================================
# Nexus API (canli mac + pit)
# https://frc.nexus/api/v1/docs
# Not: Her etkinlikte veri tam olmayabilir.
# ===========================================
NEXUS_API_KEY=""

# ===========================================
# İsteğe bağlı
# ===========================================
# Bildirim linki base URL (Vercel’de VERCEL_URL otomatik kullanılır;
# local veya custom domain’de gerekebilir)
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
